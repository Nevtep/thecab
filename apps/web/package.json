    "@tamagui/core": "2.0.0-rc.42",
    "@tamagui/next-plugin": "2.0.0-rc.42",
    "@tamagui/web": "2.0.0-rc.42",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "@trigger.dev/sdk": "^4.4.6",
    "@upstash/redis": "^1.38.0",
    "@wagmi/connectors": "^8.0.13",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "accounts": "^0.10.6",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.543.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "porto": "^0.2.37",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.7",
    "react-native-web": "^0.21.2",
    "recharts": "^3.2.1",
    "tamagui": "2.0.0-rc.42",
    "viem": "^2.48.11",
    "wagmi": "^3.6.14",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "trigger.dev": "^4.4.6",
    "tsx": "^4.21.0",
