{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy",
    "lint": "eslint",
    "test:unit": "node --experimental-test-module-mocks --import tsx --test src/i18n/locale.test.ts src/features/settings/settings.validation.test.ts src/features/overview/overview.validation.test.ts src/features/pools/pools.mappers.test.ts src/features/pools/pools.validation.test.ts src/server/analysis/analysis-slice.repository.test.ts src/server/analysis/computeSnapshots.test.ts src/server/analysis/coverage.test.ts src/server/analysis/deposit-read-models.test.ts src/server/analysis/enginePersistence.test.ts src/server/analysis/pool-read-models.test.ts src/server/analysis/sourceOfFundsWaterfall.test.ts src/server/analysis/start-policy.test.ts src/server/analysis/status-projection.test.ts src/server/overview/chart-snapshots.test.ts src/server/overview/deposit-activity.test.ts src/server/protocol-positions/detectProtocolPositions.test.ts src/server/pools/pools.route.test.ts src/server/pools/pools.repository.test.ts src/server/pools/pools.service.test.ts src/server/trigger/queues.test.ts src/server/trigger/tasks/analysis-run.test.ts src/server/trigger/tasks/analysis-slice.test.ts src/server/trigger/tasks/phase-deposits.test.ts src/server/trigger/tasks/phase-pools.test.ts src/server/trigger/tasks/phase-rewards.test.ts",
    "test:backend:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=src/server/analysis/coverage.ts --test-coverage-include=src/server/analysis/sourceOfFundsWaterfall.ts --test-coverage-include=src/server/analysis/start-policy.ts --test-coverage-include=src/server/analysis/status-projection.ts --test-coverage-include=src/server/overview/chart-snapshots.ts --test-coverage-include=src/server/trigger/queues.ts --test-coverage-include=src/server/trigger/tasks/analysis-run.task.ts --test-coverage-include=src/server/trigger/tasks/analysis-slice.task.ts --test-coverage-include=src/server/trigger/tasks/phase-pools.task.ts --import tsx --test src/server/analysis/coverage.test.ts src/server/analysis/sourceOfFundsWaterfall.test.ts src/server/analysis/start-policy.test.ts src/server/analysis/status-projection.test.ts src/server/overview/chart-snapshots.test.ts src/server/trigger/queues.test.ts src/server/trigger/tasks/analysis-run.test.ts src/server/trigger/tasks/analysis-slice.test.ts src/server/trigger/tasks/phase-pools.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:purge": "tsx src/server/scripts/db-purge.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "provider:smoke": "tsx src/server/scripts/provider-smoke.ts",
    "analysis:smoke": "tsx src/server/scripts/analysis-smoke.ts",
    "analysis:status-latency": "tsx src/server/scripts/analysis-status-latency.ts",
    "analysis:queue-audit": "tsx src/server/scripts/analysis-provider-queue-audit.ts",
    "analysis:rebuild-pools": "tsx src/server/scripts/rebuild-pool-read-models.ts",
    "i18n:check": "tsx scripts/check-i18n-parity.ts",
    "ds:check": "tsx scripts/check-ds-color-semantics.ts && tsx scripts/check-wcag-contrast.ts && tsx scripts/check-hardcoded-hex.ts",
    "ds:contrast": "tsx scripts/check-wcag-contrast.ts",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
