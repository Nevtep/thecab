# Bootstrap-required now
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_SUPPORTED_CHAIN_ID=8453
NEXT_PUBLIC_DEFAULT_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_FALLBACK_LOCALE=en

# Required backend/provider access
MORALIS_API_KEY=your_moralis_api_key
ALCHEMY_API_KEY=your_alchemy_api_key
ALCHEMY_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_api_key
DATABASE_URL=postgresql://user:password@localhost:5432/thecab
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret
TRIGGER_API_URL=https://api.trigger.dev

# Trigger.dev project wiring
# Required for local trigger dev/discovery and some runtime smoke flows.
TRIGGER_PROJECT_REF=proj_your_trigger_project_ref

# Optional Upstash/Redis cache layer
UPSTASH_REDIS_REST_URL=https://your-app.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
KV_REST_API_URL=https://your-app.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token
UPSTASH_REDIS_REST_KV_REST_API_URL=https://your-app.upstash.io
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=your_upstash_kv_rest_api_token

# Optional local behavior
ANALYSIS_DEFAULT_MODE=full_history
ANALYSIS_HISTORY_DAYS=365

# Optional analysis tuning
ANALYSIS_SLICE_DAYS=90
ANALYSIS_SLICE_CONCURRENCY=2
ANALYSIS_REBALANCE_WINDOW_HOURS=24
ANALYSIS_REORG_SOFT_BLOCKS=32
ANALYSIS_STATUS_STALE_DAYS=7

# Optional Trigger queue tuning
TRIGGER_QUEUE_MORALIS_CONCURRENCY=4
TRIGGER_QUEUE_ALCHEMY_PRICES_CONCURRENCY=3
TRIGGER_QUEUE_ALCHEMY_RPC_CONCURRENCY=6
